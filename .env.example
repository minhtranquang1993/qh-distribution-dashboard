# Supabase — copy sang .env.local và điền key (không commit)
VITE_SUPABASE_URL=https://xeitiijvywresnyjycpq.supabase.co
VITE_SUPABASE_ANON_KEY=paste-anon-key-here

# Chỉ dùng local cho script seed (không bao giờ commit, không dùng ở frontend)
# SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here

# Edge Function ingest-leads tự lưu DB khi upload CSV trên UI:
# function URL suy ra từ VITE_SUPABASE_URL + /functions/v1/ingest-leads.
# Deploy qua Dashboard (Via Editor) vì CLI thiếu quyền: paste
# supabase/functions/ingest-leads/index.ts, KHÔNG tạo secret (SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY là biến built-in), tắt Verify JWT.
# LƯU Ý: function mở, không check secret (dashboard nội bộ).
# Function enforce no-PII server-side: upload qua UI luôn chỉ lưu safe.
